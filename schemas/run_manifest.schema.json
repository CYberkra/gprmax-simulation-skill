{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulation Run Manifest",
  "type": "object",
  "required": [
    "run_id",
    "environment",
    "command",
    "inputs",
    "numerics",
    "outputs",
    "started_at",
    "finished_at",
    "return_code"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "environment": {"$ref": "#/$defs/environment"},
    "command": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "object", "additionalProperties": true},
    "numerics": {"type": "object", "additionalProperties": true},
    "outputs": {"type": "object", "additionalProperties": true},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "return_code": {"type": "integer"}
  },
  "additionalProperties": true,
  "$defs": {
    "environment": {
      "type": "object",
      "required": [
        "gprmax_version",
        "banner",
        "import_path",
        "backend",
        "real_dtype",
        "complex_dtype"
      ],
      "properties": {
        "gprmax_version": {"type": "string", "minLength": 1},
        "banner": {"type": "string", "minLength": 1},
        "import_path": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1},
        "real_dtype": {"type": "string", "minLength": 1},
        "complex_dtype": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "cuda_version": {"type": "string", "minLength": 1},
        "gpu": {"type": "string", "minLength": 1},
        "driver_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
